---
import type { MarkdownHeading } from "astro";
import type { CollectionEntry } from "astro:content";

import PostTree from "../components/PostTree.astro";
import PostMeta from "../components/PostMeta.astro";
import { getPostDate } from "../utils/post-date";
import Layout from "./Layout.astro";

interface Props {
	post: CollectionEntry<"posts">;
	headings?: MarkdownHeading[];
}

const { post, headings = [] } = Astro.props;
const { title, description, pubDate, author, tags, image } = post.data;
const published = getPostDate(pubDate);
---

<Layout
	title={`${title} | Trail`}
	description={description}
	type="article"
	author={author}
	publishedAt={pubDate}
	tags={tags}
	image={image}
>
	<a href="/posts">Back</a>
	<article class="relative">
		<PostMeta
			title={title}
			publishedAt={published.datetime}
			publishedLabel={published.label}
			author={author}
			tags={tags}
		/>
		<div class="post-body">
			{headings.length > 0 && (
				<aside class="post-tree border border-white/50 p-5 rounded-lg" aria-label="Menu">
					<strong>Menu</strong>
					<PostTree headings={headings} />
					<strong><a href="#">TOP</a></strong>
				</aside>
			)}
			<div class="post-content">
				<slot />
			</div>
		</div>
	</article>
</Layout>
