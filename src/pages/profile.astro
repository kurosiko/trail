---
import Layout from "../layouts/Layout.astro";
import myImage from "..//assets/kurosiko.webp"
import {Image} from "astro:assets"
---

<Layout title="Profile | Trail" description="about me">
    <p>Name:kurosiko</p>
    <p>Age:12</p>
    <p>Vibe-coder</p>
    <p>This is my face</p>
    <div class="rotate-x-50 rotate-y-150 rotate-z-200 fixed top-0 left-50 opacity-20 animate-spin">
        <Image
            src={myImage}
            alt='my cool face image'
        />
    </div>
   </Layout>
