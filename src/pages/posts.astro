---
import type { CollectionEntry } from "astro:content";
import { getCollection } from "astro:content";

import Layout from "../layouts/Layout.astro";
import { getPostDate } from "../utils/post-date";

type Post = CollectionEntry<"posts">;

const posts = (await getCollection("posts", ({ data }) => !data.draft)).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<Layout title="Blog | Trail" description="Trailの記事一覧">
	<section>
		<p class="eyebrow">Blog</p>
		<h1>Posts</h1>
		<ul class="mt-8 list-none border-t border-[#dfe3db] p-0">
			{
				posts.map((post: Post) => {
					const published = getPostDate(post.data.pubDate);

					return (
						<li>
							<a
								href={`/posts/${post.id}`}
								class="flex justify-between gap-4 border-b border-[#dfe3db] py-4 no-underline"
							>
								<span>
									<strong class="block">{post.data.title}</strong>
									<small class="mt-1 block font-normal text-[#a9b4c9]">{post.data.description}</small>
								</span>
								<time class="text-[#667085]" datetime={published.datetime}>{published.label}</time>
							</a>
						</li>
					);
				})
			}
		</ul>
	</section>
</Layout>
