---
import type { CollectionEntry } from "astro:content";
import { getCollection } from "astro:content";

import Layout from "../layouts/Layout.astro";
import { getPostDate } from "../utils/post-date";

type Post = CollectionEntry<"posts">;

const posts = (await getCollection("posts", ({ data }) => !data.draft)).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<Layout title="Blog | Trail" description="Trailの記事一覧">
	<section>
		<p class="eyebrow">Blog</p>
		<h1>Articles</h1>
		<ul class="post-list">
			{
				posts.map((post: Post) => {
					const published = getPostDate(post.data.pubDate);

					return (
						<li>
							<a href={`/posts/${post.id}`}>
								<span>
									<strong>{post.data.title}</strong>
									<small>{post.data.description}</small>
								</span>
								<time datetime={published.datetime}>{published.label}</time>
							</a>
						</li>
					);
				})
			}
		</ul>
	</section>
</Layout>

<style>
	.post-list strong,
	.post-list small {
		display: block;
	}

	.post-list small {
		margin-top: 0.25rem;
		color: #a9b4c9;
		font-weight: 400;
	}
</style>
