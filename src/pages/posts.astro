---
import Layout from "../layouts/Layout.astro";
import PostListItem from "../components/PostListItem.astro";
import { getPostGroups, getPosts, getTopics } from "../utils/post-query";

const requestedTopic = Astro.url.searchParams.get("topic") ?? "";
const allPosts = await getPosts();
const topics = getTopics(allPosts);
const selectedTopic = topics.includes(requestedTopic) ? requestedTopic : "";
const posts = selectedTopic ? await getPosts(selectedTopic) : allPosts;
const postGroups = getPostGroups(posts);
const pageTitle = selectedTopic ? `${selectedTopic} | Trail` : "Blog | Trail";
const pageDescription = selectedTopic ? `検索結果:${selectedTopic}` : "Trailの記事一覧";
---

<Layout title={pageTitle} description={pageDescription}>
	<section>
		<p class="eyebrow">Blog</p>
		<h1>Posts</h1>
		<form method="get" action="/posts" class="mt-6 flex items-center gap-3">
			<label for="topic" class="font-semibold">TOPIC</label>
			<select name="topic" id="topic" onchange="this.form.submit()">
				<option value="" selected={selectedTopic === ""}>すべて</option>
				{topics.map((topic) => (
					<option value={topic} selected={selectedTopic === topic}>{topic}</option>
				))}
			</select>
		</form>
		<div class="post-hierarchy mt-8">
			{postGroups.map((group) => (
				<details class="post-provider" data-group open>
					<summary>
						<span>{group.provider}</span>
						<small>{group.directPosts.length + [...group.courses.values()].flat().length} 件</small>
					</summary>
					<div class="post-provider-content">
						{group.directPosts.length > 0 && (
							<ul class="post-items" data-items>
								{group.directPosts.map((post) => <PostListItem post={post} />)}
							</ul>
						)}
						{[...group.courses.entries()].sort(([a], [b]) => a.localeCompare(b)).map(([course, coursePosts]) => (
							<details class="post-course" data-group open>
								<summary>
									<span>{course}</span>
									<small>{coursePosts.length} 件</small>
								</summary>
								<ul class="post-items" data-items>
									{coursePosts.map((post) => <PostListItem post={post} />)}
								</ul>
							</details>
						))}
					</div>
				</details>
			))}
		</div>
		{posts.length === 0 && <p class="mt-8">該当する投稿はありません。</p>}
	</section>
</Layout>


<script>
	const applyTopicFilter = () => {
		const select = document.querySelector<HTMLSelectElement>("#topic");
		if (!select) return;

		const requestedTopic = new URL(window.location.href).searchParams.get("topic") ?? "";
		const isKnownTopic = [...select.options].some((option) => option.value === requestedTopic);
		const selectedTopic = isKnownTopic ? requestedTopic : "";
		select.value = selectedTopic;
		document.title = selectedTopic ? `${selectedTopic} | Trail` : "Blog | Trail";

		for (const post of document.querySelectorAll<HTMLElement>("[data-topics]")) {
			const topics = (post.dataset.topics ?? "").split(",");
			post.hidden = Boolean(selectedTopic) && !topics.includes(selectedTopic);
		}

		for (const group of document.querySelectorAll<HTMLElement>("[data-group]")) {
			group.hidden = !group.querySelector("[data-topics]:not([hidden])");
		}
	};

	document.addEventListener("astro:page-load", applyTopicFilter);
	applyTopicFilter();
</script>
